# Shell scripts must keep LF endings — CRLF makes the Pi fail with
# "bad interpreter: /bin/bash^M" when the GUI launches the sender.
*.sh    text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.txt   text eol=lf

# Windows batch files need CRLF
*.bat   text eol=crlf

*.pt    binary
*.png   binary
*.jpg   binary
